# ==== 이 파일을 .env 로 복사한 뒤 값을 채우세요 (cp .env.example .env) ====
# 모든 서버에 같은 값을 쓰되, NODE_ID 와 NODE_ROLES 만 서버마다 다르게 하면 됩니다.

# --- 서버 구분
NODE_ID=server1
# chat: 웹 대화 / telegram: 텔레그램 담당 후보 / autonomy: 학습·회고 담당 후보
NODE_ROLES=chat,telegram,autonomy

# --- 주인 인증 (아무도 모르는 긴 문자열로. 예: openssl rand -hex 32)
OWNER_TOKEN=
# PC 에이전트 연결용 비밀번호 (OWNER_TOKEN 과 다르게)
PC_TOKEN=

# --- 텔레그램 (BotFather 에게 받은 토큰, 내 텔레그램 숫자 ID)
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_ID=

# --- 두뇌 API 키 (하나 이상. 많을수록 빠르고 튼튼함)
GROQ_API_KEY=
CEREBRAS_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
# 선택: Claude (유료)
ANTHROPIC_API_KEY=

# --- 공유 기억 DB (Supabase 연결 문자열). 비우면 서버 내부 파일(SQLite)을 사용
# 예: postgresql://postgres.xxxx:비밀번호@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres
DATABASE_URL=

# --- 자체 두뇌 (docker compose --profile local-brain 사용 시 주석 해제)
# LOCAL_LLM_URL=http://llama:8080/v1
# LOCAL_MODEL=Qwen/Qwen2.5-3B-Instruct-GGUF:Q4_K_M

# --- HTTPS 주소 (docker compose --profile https 사용 시). 예: myai.duckdns.org
DOMAIN=

# --- 세부 조정 (기본값으로 충분)
# HEDGE_MS=1200                 # 첫 글자가 이 시간 안에 안 오면 다음 두뇌도 동시에 출발
# MAX_PARALLEL=2
# PRIVATE_MODE=false            # true 면 입력을 학습에 쓰는 무료 API(Gemini 무료)로는 대화를 안 보냄
# EMBED_PROVIDER=auto           # auto | gemini | openai | hash
# EMBED_DIM=768
# LEARN_INTERVAL_HOURS=3
# REFLECT_INTERVAL_HOURS=12
# PROACTIVE_MIN_GAP_HOURS=8     # 먼저 말 거는 최소 간격
# QUIET_HOURS=1-8               # 이 시간엔 먼저 말 걸지 않음
# TZ_NAME=Asia/Seoul
# LEARN_FEEDS=https://news.hada.io/rss/news,https://hnrss.org/frontpage
